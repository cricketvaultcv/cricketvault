# Copy this file to server/.env and replace every placeholder before starting the API.
# Do not commit server/.env or put private keys in client/.env files.

NODE_ENV=development
API_PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/cricketvault?replicaSet=rs0
JWT_SECRET=replace-with-a-long-random-secret
OTP_HASH_SECRET=replace-with-another-long-random-secret
CLIENT_URL=http://localhost:5173

# Optional Google Identity Services sign-in; existing accounts only.
GOOGLE_CLIENT_ID=

# Email OTPs and transactional notifications through Brevo's HTTPS API.
BREVO_API_KEY=
EMAIL_FROM="CricketVault <no-reply@your-verified-domain.example>"
# Optional. Defaults to ${CLIENT_URL}/cricketvault-logo.png, which is included in the frontend build.
EMAIL_LOGO_URL=

# Email address that receives server/database/error alerts. Leave blank to disable alerts.
MONITORING_ALERT_EMAIL=
# Prevent duplicate incident emails. Default: 900000 (15 minutes).
MONITORING_ALERT_COOLDOWN_MS=900000


# Optional signup SMS OTPs. If MSG91_TEMPLATE_ID is empty, signup uses email OTP.
# When enabled, configure a MSG91 Flow template with the OTP mapped to var1.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Razorpay is optional for local development. Use Test Mode credentials locally.
RAZORPAY_MODE=test
# Set true only on an isolated Render test deployment using Razorpay Test Mode keys.
RAZORPAY_ALLOW_TEST_MODE_IN_PRODUCTION=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Local demo seed only. Use strong, unique passwords and never seed production.
DEMO_ADMIN_PASSWORD=
DEMO_COACH_PASSWORD=
DEMO_PLAYER_PASSWORD=

# Optional one-time admin creation via `npm run create-admin -w server`.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
