# Copy this file to /var/www/cricketvault/server/.env on the VPS.
# Never commit the resulting .env file.
NODE_ENV=production
API_PORT=4000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/cricketvault?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-value
OTP_HASH_SECRET=replace-with-a-different-long-random-value

# Exact public frontend origin; no trailing slash.
CLIENT_URL=https://yourdomain.in

# Google Identity Services uses an ID-token flow, not a server redirect callback.
# Configure https://yourdomain.in as an Authorized JavaScript origin in Google Cloud.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Email / optional SMS
BREVO_API_KEY=
EMAIL_FROM="CricketVault <no-reply@yourdomain.in>"
# Defaults to https://yourdomain.in/cricketvault-logo.png
EMAIL_LOGO_URL=https://yourdomain.in/cricketvault-logo.png
# Email address for API, MongoDB and unexpected-server-error alerts.
MONITORING_ALERT_EMAIL=owner@yourdomain.in
MONITORING_ALERT_COOLDOWN_MS=900000
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Razorpay production credentials. Do not allow test credentials in production.
RAZORPAY_MODE=live
RAZORPAY_ALLOW_TEST_MODE_IN_PRODUCTION=false
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-with-a-separate-webhook-secret

# Do not set DEMO_* or BOOTSTRAP_ADMIN_* on a production server.
